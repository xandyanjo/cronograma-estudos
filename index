// ─── APP ──────────────────────────────────────────────────────
function App(){
  // ── estados persistidos no localStorage ──
  const[concl,setConcl]        =useLS(LS.C,{},isObj);
  const[topC,setTopC]          =useLS(LS.TC,{},isObj);
  const[topP,setTopP]          =useLS(LS.TP,{},isObj);
  const[resumos,setResumos]    =useLS(LS.R,{},isObj);
  const[reg,setReg]            =useLS(LS.RD,{},isObj);
  const[diarios,setDiarios]    =useLS(LS.D,{},isObj);
  const[topR,setTopR]          =useLS(LS.TR,{},isObj);
  const[badges,setBadges]      =useLS(LS.B,{},isObj);
  const[topRen,setTopRen]      =useLS(LS.RN,{},isObj);
  const[dataProva,setDataProva]=useLS(LS.DP,DATA_PROVA_PAD,v=>typeof v==='string');
  const[tSaved,setTSaved]      =useLS(LS.T,{},isObj);
  const[pRodSaved,setPRodSaved]=useLS(LS.PR,0,v=>typeof v==='number');
  const[dataInicioPlano,setDataInicioPlano]=useLS(LS.DI,'',v=>typeof v==='string');
  // ── estados de UI ──
  const[ui,dispatchUI]=useReducer(uiR,UI0);
  const[ed,dispatchED]=useReducer(edR,ED0);
  const[toast,setToast]=useState(null);
  const[frase]=useState(()=>FRASES[Math.floor(Math.random()*FRASES.length)]);
  // ── controle de sync ──
  const[currentUid,setCurrentUid]=useState(()=>window._uid);
  const[fbLoaded,setFbLoaded]=useState(false); // true após Firebase carregar — causa re-render para ativar save
  const saveRef=useRef(null);
  const skipSaveRef=useRef(false); // true enquanto dados remotos estão sendo aplicados

  // ── auth: login/logout subsequentes ──
  useEffect(()=>{
    const handler=e=>{
      const user=e.detail;
      if(user){
        const prevUid=window._uid; // UID anterior (pode ser anônimo u_xxx)
        window._uid=user.uid;
        localStorage.setItem('_uid',user.uid);

        // ── MIGRAÇÃO: se vinha de UID anônimo, tenta copiar dados para o Google UID ──
        if(prevUid&&prevUid.startsWith('u_')&&prevUid!==user.uid&&window.db){
          const anonRef=window.db.ref(`/usuarios/${prevUid}`);
          const googleRef=window.db.ref(`/usuarios/${user.uid}`);
          // Só migra se o Google UID ainda não tem dados próprios
          googleRef.once('value').then(snap=>{
            if(!snap.val()){
              // Google UID vazio → copia dados anônimos para ele
              anonRef.once('value').then(anonSnap=>{
                const d=anonSnap.val();
                if(d){
                  googleRef.set(d)
                    .then(()=>{console.log('[Firebase] Dados migrados do UID anônimo para Google UID.');anonRef.remove();})
                    .catch(err=>console.error('[Firebase] Erro na migração:',err));
                }
              });
            }
          });
        }

        setCurrentUid(user.uid);
      }
      else{setCurrentUid(window._uid);}
      clearTimeout(saveRef.current);
      setFbLoaded(false);
      skipSaveRef.current=false;
    };
    window.addEventListener('authStateChanged',handler);
    return()=>window.removeEventListener('authStateChanged',handler);
  },[]);

  // ── listener Firebase em tempo real ──
  // Quando currentUid muda: cancela timer de save, aguarda Firebase, aplica dados
  useEffect(()=>{
    if(!window.db)return;
    // ao trocar de usuário, cancela qualquer save pendente imediatamente
    clearTimeout(saveRef.current);
    setFbLoaded(false);
    const ref=window.db.ref(`/usuarios/${currentUid}`);
    const aplicarDados=snap=>{
      const d=snap.val();
      if(d){
        // bloqueia save enquanto aplica dados remotos
        skipSaveRef.current=true;
        if(d.concluidos&&isObj(d.concluidos))setConcl(d.concluidos);
        if(d.topicosCompletos&&isObj(d.topicosCompletos))setTopC(d.topicosCompletos);
        if(d.topicosPersonalizados&&isObj(d.topicosPersonalizados))setTopP(d.topicosPersonalizados);
        if(d.resumos&&isObj(d.resumos))setResumos(d.resumos);
        if(d.registrosDiarios&&isObj(d.registrosDiarios))setReg(d.registrosDiarios);
        if(d.diarios&&isObj(d.diarios))setDiarios(d.diarios);
        if(d.topicosRevisar&&isObj(d.topicosRevisar))setTopR(d.topicosRevisar);
        if(d.badges&&isObj(d.badges))setBadges(d.badges);
        if(d.topicosRenomeados&&isObj(d.topicosRenomeados))setTopRen(d.topicosRenomeados);
        if(d.dataProva&&typeof d.dataProva==='string')setDataProva(d.dataProva);
        if(d.tempos&&isObj(d.tempos))setTSaved(d.tempos);
        if(typeof d.pomodoroRodadas==='number')setPRodSaved(d.pomodoroRodadas);
        if(d.dataInicioPlano&&typeof d.dataInicioPlano==='string')setDataInicioPlano(d.dataInicioPlano);
      }
      // Firebase respondeu — libera saves futuros (setState causa re-render que ativa o save)
      setFbLoaded(true);
    };
    ref.on('value',aplicarDados,()=>{setFbLoaded(true);});
    return()=>{ref.off('value',aplicarDados);clearTimeout(saveRef.current);};
  },[currentUid]);

  // ── save com debounce ──
  // Regras: 1) só salva após Firebase ter carregado  2) ignora ciclo causado por update remoto
  useEffect(()=>{
    if(!window.db)return;
    // se Firebase ainda não carregou para este uid, não agenda nada
    if(!fbLoaded)return;
    clearTimeout(saveRef.current);
    saveRef.current=setTimeout(()=>{
      if(skipSaveRef.current){skipSaveRef.current=false;return;}
      window.db.ref(`/usuarios/${currentUid}`).set({
        concluidos:concl,topicosCompletos:topC,topicosPersonalizados:topP,
        resumos,registrosDiarios:reg,diarios,topicosRevisar:topR,
        badges,topicosRenomeados:topRen,dataProva,tempos:tSaved,
        pomodoroRodadas:pRodSaved,dataInicioPlano
      }).then(()=>{
        // save ok — silencioso
      }).catch(err=>{
        console.error('[Firebase] Erro ao salvar dados:', err.code, err.message);
        // Só alerta o usuário se for erro de permissão (ajuda no diagnóstico)
        if(err.code==='PERMISSION_DENIED'){
          console.warn('[Firebase] Permissão negada — verifique as regras do Realtime Database e se está logado.');
        }
      });
    },2000);
  },[concl,topC,topP,resumos,reg,diarios,topR,badges,topRen,dataProva,tSaved,pRodSaved,dataInicioPlano,currentUid,fbLoaded]);

  const regHoje=useCallback((seg,data)=>{if(seg<=0)return;const d=data||hoje();setReg(p=>({...p,[d]:(p[d]||0)+seg}));},[]);
  const cron=useCron(tSaved,setTSaved,regHoje);
  const pomo=usePomo(pRodSaved,setPRodSaved);
  const semanaAtual=useMemo(()=>calcSemAtual(dataInicioPlano),[dataInicioPlano]);

  // Auto-navega para semana atual quando dataInicioPlano é definido
  useEffect(()=>{if(dataInicioPlano)dispatchUI({t:'SEM',p:calcSemAtual(dataInicioPlano)});},[dataInicioPlano]);

  // Déficit acumulado total (semanas passadas)
  const deficitTotal=useMemo(()=>{
    if(!dataInicioPlano)return 0;
    let def=0;
    for(let s=1;s<semanaAtual;s++){
      const cfg=CRONOGRAMA[s]||{f:0};const fase=FASES[cfg.f]||FASES[0];
      const meta=fase.materias.reduce((a,m)=>a+m.horas*3600,0);
      const tempo=Object.entries(tSaved).filter(([k])=>k.startsWith(`${s}-`)).reduce((a,[,v])=>a+v,0);
      def+=Math.max(0,meta-tempo);
    }
    return def;
  },[dataInicioPlano,semanaAtual,tSaved]);

  // Déficit acumulado por matéria
  const deficitPorMateria=useMemo(()=>{
    if(!dataInicioPlano)return {};
    const d={};
    for(let s=1;s<semanaAtual;s++){
      const cfg=CRONOGRAMA[s]||{f:0};const fase=FASES[cfg.f]||FASES[0];
      fase.materias.forEach(mat=>{
        const meta=mat.horas*3600;const tempo=tSaved[`${s}-${mat.id}`]||0;
        const def=Math.max(0,meta-tempo);
        if(def>0)d[mat.id]=(d[mat.id]||0)+def;
      });
    }
    return d;
  },[dataInicioPlano,semanaAtual,tSaved]);

  const streak=useMemo(()=>{let c=0;const d=new Date();const hj=d.toISOString().split('T')[0];if(!reg[hj]||reg[hj]<STREAK_MIN)d.setDate(d.getDate()-1);for(let i=0;i<365;i++){const s=d.toISOString().split('T')[0];if(reg[s]&&reg[s]>=STREAK_MIN){c++;d.setDate(d.getDate()-1);}else break;}return c;},[reg]);
  const diasR=useMemo(()=>{const p=new Date(`${dataProva}T12:00:00`);return Math.max(0,Math.ceil((p-new Date())/86400000));},[dataProva]);
  const tempoTot=useMemo(()=>Object.values(reg).reduce((a,v)=>a+v,0),[reg]);
  const totTop=useMemo(()=>Object.values(topC).filter(Boolean).length,[topC]);
  const totSem=useMemo(()=>Object.values(concl).filter(Boolean).length,[concl]);
  const proGeral=useMemo(()=>Math.round(totSem/28*100),[totSem]);

  useEffect(()=>{
    const m={tt:tempoTot,sk:streak,pr:pomo.rod,tc:totTop};
    BADGES.forEach(b=>{if(!badges[b.id]&&b.chk(m)){setBadges(p=>({...p,[b.id]:new Date().toISOString()}));setToast(b);setTimeout(()=>setToast(null),TOAST_MS);}});
  },[tempoTot,streak,pomo.rod,totTop,badges]);

  const salvarResumo=useCallback((k,txt)=>{setResumos(p=>{if(!txt?.trim()){const n={...p};delete n[k];return n;}return{...p,[k]:txt.trim()};});dispatchED({t:'FR'});},[]);
  const salvarDiario=useCallback((sem,txt)=>{setDiarios(p=>({...p,[String(sem)]:txt}));dispatchED({t:'CD'});},[]);

  const exportar=()=>{const d={versao:'2.0',exportadoEm:new Date().toISOString(),tempos:cron.tempos,concluidos:concl,topicosCompletos:topC,topicosPersonalizados:topP,resumos,registrosDiarios:reg,diarios,topicosRevisar:topR,badgesGanhos:badges,pomodoroRodadas:pomo.rod,topicosRenomeados:topRen,dataProva};const b=new Blob([JSON.stringify(d,null,2)],{type:'application/json'});const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download=`estudo-backup-${hoje()}.json`;a.click();URL.revokeObjectURL(u);};
  const importar=e=>{const f=e.target.files?.[0];if(!f)return;const r=new FileReader();r.onload=ev=>{try{const d=JSON.parse(ev.target.result);if(!d||typeof d!=='object'){alert('❌ Arquivo inválido.');return;}if(d.concluidos)setConcl(d.concluidos);if(d.topicosCompletos)setTopC(d.topicosCompletos);if(d.topicosPersonalizados)setTopP(d.topicosPersonalizados);if(d.resumos)setResumos(d.resumos);if(d.registrosDiarios)setReg(d.registrosDiarios);if(d.diarios)setDiarios(d.diarios);if(d.topicosRevisar)setTopR(d.topicosRevisar);if(d.badgesGanhos)setBadges(d.badgesGanhos);if(d.topicosRenomeados)setTopRen(d.topicosRenomeados);if(d.dataProva)setDataProva(d.dataProva);if(d.tempos)setTSaved(d.tempos);alert(`✅ Dados importados! (v${d.versao||'?'})`);}catch(err){alert('❌ Erro: '+err.message);}};r.readAsText(f);e.target.value='';};
  const resetar=()=>{if(!confirm('⚠️ Apagar TODOS os dados? Esta ação é irreversível.\n\nExporte um backup antes!'))return;try{Object.values(LS).forEach(k=>localStorage.removeItem(k));setTimeout(()=>window.location.reload(),100);}catch(err){alert('Erro: '+err.message);}};

  const S={ui,dispatchUI,ed,dispatchED,concl,setConcl,topC,setTopC,topP,setTopP,resumos,setResumos,reg,setReg,diarios,topR,setTopR,badges,setBadges,topRen,setTopRen,dataProva,setDataProva,dataInicioPlano,setDataInicioPlano,semanaAtual,deficitTotal,deficitPorMateria,streak,diasR,tempoTot,totTop,totSem,proGeral,frase,cron,pomo,salvarResumo,salvarDiario,FASES,CRONOGRAMA};
  const{view}=ui;

  return(
    <div style={{minHeight:'100vh',background:'#0f172a',color:'white'}}>
      <Toast badge={toast}/>
      {ui.showS&&<SearchModal S={S}/>}
      {ui.showP&&<PomoModal pomo={pomo} onClose={()=>dispatchUI({t:'POMO'})}/>}
      <div style={{paddingBottom:80}}>
        {view==='dashboard'  &&<Dashboard S={S}/>}
        {view==='cronograma' &&<CronogramaView S={S}/>}
        {view==='revisao'    &&<RevisaoView S={S}/>}
        {view==='conquistas' &&<Conquistas S={S}/>}
      </div>
      {/* Toolbar flutuante */}
      <div style={{position:'fixed',bottom:68,left:0,right:0,zIndex:30,display:'flex',justifyContent:'center',pointerEvents:'none'}}>
        <div style={{display:'flex',alignItems:'center',gap:8,background:'rgba(17,24,39,0.95)',backdropFilter:'blur(8px)',border:'1px solid #374151',borderRadius:24,padding:'6px 16px',pointerEvents:'auto'}}>
          <button onClick={()=>dispatchUI({t:'SEARCH',p:{t:'',r:[]}})} title="Pesquisar" style={{color:'#9ca3af',background:'none',border:'none',cursor:'pointer',fontSize:16,padding:'4px 8px'}} className="hover:text-white transition-colors">🔍</button>
          <div style={{width:1,height:16,background:'#374151'}}/>
          <button onClick={()=>dispatchUI({t:'POMO'})} title="Pomodoro" style={{color:pomo.at?'#4ade80':'#9ca3af',background:'none',border:'none',cursor:'pointer',fontSize:14,padding:'4px 8px'}} className="transition-colors">
            🍅{pomo.rod>0?` ${pomo.rod}`:''}
          </button>
          <div style={{width:1,height:16,background:'#374151'}}/>
          <button onClick={exportar} title="Exportar" style={{color:'#9ca3af',background:'none',border:'none',cursor:'pointer',fontSize:16,padding:'4px 8px'}} className="hover:text-white transition-colors">⬇</button>
          <label title="Importar" style={{color:'#9ca3af',cursor:'pointer',fontSize:16,padding:'4px 8px'}} className="hover:text-white transition-colors">
            ⬆<input type="file" accept=".json" onChange={importar} style={{display:'none'}}/>
          </label>
          <div style={{width:1,height:16,background:'#374151'}}/>
          <button onClick={resetar} title="Limpar todos os dados" style={{color:'#6b7280',background:'none',border:'none',cursor:'pointer',fontSize:14,padding:'4px 8px'}} className="hover:text-red-400 transition-colors">🗑</button>
        </div>
      </div>
      <NavBar view={view} dispatchUI={dispatchUI}/>
    </div>
  );
}

// Root criado uma única vez
