// ─── GOOGLE LOGIN BTN ─────────────────────────────────────────
function GoogleLoginBtn(){
  const[user,setUser]=useState(null);
  const[loading,setLoading]=useState(false);

  useEffect(()=>{
    const u=window.auth&&window.auth.currentUser;
    if(u)setUser(u);
    // só atualiza o ícone visual — a lógica de sync fica no App
    const handler=e=>setUser(e.detail);
    window.addEventListener('authStateChanged',handler);
    return()=>window.removeEventListener('authStateChanged',handler);
  },[]);

  const login=async()=>{
    if(!window.auth||!window.googleProvider)return;
    setLoading(true);
    try{await window.auth.signInWithPopup(window.googleProvider);}
    catch(e){if(e.code!=='auth/popup-closed-by-user')alert('Erro ao fazer login: '+e.message);}
    finally{setLoading(false);}
  };

  const logout=async()=>{
    if(!window.auth)return;
    if(!confirm('Sair da conta Google?'))return;
    await window.auth.signOut();
    let uid=localStorage.getItem('_uid_anon');
    if(!uid){uid='u_'+Date.now().toString(36)+Math.random().toString(36).slice(2);localStorage.setItem('_uid_anon',uid);}
    window._uid=uid;
    localStorage.setItem('_uid',uid);
    // dispara o evento para o React atualizar o estado
    window.dispatchEvent(new CustomEvent('authStateChanged',{detail:null}));
  };

  if(loading)return(
    <button disabled style={{display:'flex',flexDirection:'column',alignItems:'center',gap:2,fontSize:11,color:'#9ca3af',border:'none',background:'none',padding:'8px 10px'}}>
      <span style={{fontSize:18,lineHeight:1}}>⏳</span>
      <span>...</span>
    </button>
  );

  if(user)return(
    <button onClick={logout} title={`Logado: ${user.displayName||user.email}`}
      style={{display:'flex',flexDirection:'column',alignItems:'center',gap:2,fontSize:11,color:'#34d399',border:'none',background:'none',cursor:'pointer',padding:'8px 10px',transition:'color .2s',maxWidth:64}}>
      {user.photoURL
        ?<img src={user.photoURL} alt="" style={{width:20,height:20,borderRadius:'50%',border:'2px solid #34d399'}}/>
        :<span style={{fontSize:18,lineHeight:1}}>👤</span>}
      <span style={{overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap',maxWidth:56}}>
        {(user.displayName||user.email||'').split(' ')[0]}
      </span>
    </button>
  );

  return(
    <button onClick={login} title="Entrar com Google para sincronizar entre dispositivos"
      style={{display:'flex',flexDirection:'column',alignItems:'center',gap:2,fontSize:11,color:'#f59e0b',border:'1px solid rgba(245,158,11,0.4)',background:'rgba(245,158,11,0.1)',cursor:'pointer',padding:'6px 10px',transition:'all .2s',borderRadius:8}}
      className="hover:text-white">
      <span style={{fontSize:18,lineHeight:1}}>🔐</span>
      <span>Sincronizar</span>
    </button>
  );
}

