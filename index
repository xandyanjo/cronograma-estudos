  case'IN':return{...s,eN:a.k,nT:a.v};case'UN':return{...s,nT:a.p};case'FN':return{...s,eN:null,nT:''};
  case'IR':return{...s,eR:a.k,rT:a.v};case'UR':return{...s,rT:a.p};case'FR':return{...s,eR:null,rT:''};
